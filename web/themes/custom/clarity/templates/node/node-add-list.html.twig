{#
/**
 * @file
 * Theme override for the list of available content types on /node/add.
 *
 * Renders content types as tabs instead of a plain list.
 *
 * Available variables:
 * - content: List of content type items. Each item contains:
 *   - add_link: Rendered link to add a node of this type.
 *   - description: Content type description.
 */
#}
{% if content %}
  <nav class="at-tabs at-node-add-tabs" aria-label="{{ 'Content types'|t }}">
    {% for item in content %}
      {{ item.add_link }}
    {% endfor %}
  </nav>
{% endif %}
