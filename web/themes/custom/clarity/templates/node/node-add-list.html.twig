{#
/**
 * @file
 * Theme override for the list of available content types on /node/add.
 *
 * Available variables:
 * - content: List of content type items. Each item contains:
 *   - type: The NodeType config entity.
 *   - description: Content type description render array.
 */
#}
{% if content %}
  <div class="at-content-type-list">
    {% for item in content %}
      <div class="at-content-type-card">
        <div class="at-content-type-card__title">
          <a href="{{ path('node.add', {'node_type': item.type.id}) }}">{{ item.type.label }}</a>
        </div>
        {% if item.description %}
          <p class="at-content-type-card__description">{{ item.description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% else %}
  <p>{{ 'No content types are available.'|t }}</p>
{% endif %}
