{#
/**
 * @file
 * Theme override for the basic structure of a single Drupal page.
 *
 * Variables:
 * - html_attributes: HTML attributes for the <html> element.
 * - attributes: HTML attributes for the <body> element.
 * - logged_in: A flag indicating if user is logged in.
 * - root_path: The root path of the current page (e.g. 'node').
 * - node_type: The content type for the current node (if any).
 * - head_title: List of text elements for the <title> tag.
 * - page_top: Initial rendered markup — print before 'page'.
 * - page: The rendered page markup.
 * - page_bottom: Closing rendered markup — print after 'page'.
 * - placeholder_token: Token for head/css/js placeholders (BigPipe).
 */
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
  </head>
  <body{{ attributes }}>
    <a href="#main-content" class="visually-hidden focusable">
      {{- 'Skip to main content'|t -}}
    </a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    <js-bottom-placeholder token="{{ placeholder_token }}">
  </body>
</html>
