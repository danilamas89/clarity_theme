{#
/**
 * @file
 * Theme override for status messages.
 *
 * Each message is dismissible via Alpine.js x-data.
 *
 * Available variables:
 * - message_list: List of messages to be displayed, grouped by type.
 *   - type: The type of message (e.g. status, warning, error, info).
 *   - messages: Messages for this type.
 * - status_headings: Headings keyed by message type.
 * - attributes: HTML attributes for the messages container.
 */
#}
{% if message_list %}
  <div class="at-messages"{{ attributes }}>
    {% for type, messages in message_list %}
      {% set type_class = {
        'status': 'at-message--success',
        'warning': 'at-message--warning',
        'error': 'at-message--danger',
        'info': 'at-message--info',
      }[type] ?? 'at-message--info' %}

      {% for message in messages %}
        <div class="at-message {{ type_class }}"
          x-data="{ visible: true }"
          x-show="visible"
          x-transition:leave.duration.300ms
          {% if type == 'status' %}data-auto-dismiss="5000"{% endif %}
          role="alert"
          aria-live="polite">

          {# Icon #}
          <span class="at-message__icon" aria-hidden="true">
            {% if type == 'status' %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            {% elseif type == 'warning' %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
            {% elseif type == 'error' %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
            {% else %}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            {% endif %}
          </span>

          {# Body #}
          <div class="at-message__body">
            {% if status_headings[type] %}
              <div class="at-message__title">{{ status_headings[type] }}</div>
            {% endif %}
            <div class="at-message__content">{{ message }}</div>
          </div>

          {# Dismiss button #}
          <button class="at-message__close"
            @click="visible = false"
            :aria-label="'{{ 'Dismiss message'|t }}'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>

        </div>
      {% endfor %}
    {% endfor %}
  </div>
{% endif %}
